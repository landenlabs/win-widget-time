<Window x:Class="WinWidgetTime.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WinWidgetTime"
        Width="380" Height="560"
        MinWidth="380" MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="182"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Company logo — video or static fallback -->
        <Image x:Name="LogoFallback" Grid.Row="0"
               Stretch="Uniform"
               Visibility="Collapsed"/>
        <MediaElement x:Name="LogoPlayer" Grid.Row="0"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      IsMuted="True"
                      Stretch="Uniform"
                      Visibility="Collapsed"/>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,18,0">

                <!-- App name + version -->
                <TextBlock Text="🕐  WinWidgetTime" FontSize="22" FontWeight="Bold"
                           Foreground="#FF7AA2F7"/>
                <TextBlock x:Name="VersionText"
                           Foreground="#FF6C7086" FontSize="12" Margin="0,4,0,0"/>

                <Rectangle Height="1" Fill="#FF313244" Margin="0,12,0,0"/>

                <!-- Info -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="#FFBAC2DE" LineHeight="22">
                        Displays live time for any city or time zone as a transparent overlay
                        on your Windows desktop wallpaper.
                    </TextBlock>
                    <TextBlock Margin="0,12,0,0" Foreground="#FFBAC2DE" FontSize="11">
                        <Run>Created by: LanDen Labs (2026)</Run>
                    </TextBlock>
                    <TextBlock Foreground="#FFBAC2DE" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run>GitHub:&#x2003;&#x2003;&#x2003;</Run><Hyperlink NavigateUri="https://github.com/landenlabs/win-widget-time.git"
                                     RequestNavigate="Hyperlink_RequestNavigate"
                                     Foreground="#FF89B4FA">https://github.com/landenlabs/win-widget-time.git</Hyperlink>
                    </TextBlock>
                    <TextBlock Foreground="#FFBAC2DE" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run>Privacy:&#x2003;&#x2003;&#x2002;</Run><Hyperlink NavigateUri="https://landenlabs.github.io/win-widget-time/privacy.html"
                                     RequestNavigate="Hyperlink_RequestNavigate"
                                     Foreground="#FF89B4FA">Privacy policy</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,12,0,0" Foreground="#FF6C7086" FontSize="11" TextWrapping="Wrap">
                        City lookup powered by OpenStreetMap Nominatim + GeoTimeZone
                        (the city name you type is sent to Nominatim when you press Look up).
                    </TextBlock>
                    <TextBlock Foreground="#FF6C7086" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                        Time zone data provided by TimeZoneConverter / IANA TZDB.
                    </TextBlock>
                </StackPanel>

                <Rectangle Height="1" Fill="#FF313244" Margin="0,12,0,0"/>

                <!-- Usage hints -->
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Foreground="#FFA6ADC8" FontSize="11" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="#FF89B4FA">Hover</Run>
                        <Run> the widget to reveal ⚙ and ? buttons.</Run>
                    </TextBlock>
                    <TextBlock Foreground="#FFA6ADC8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="#FF89B4FA">Drag</Run>
                        <Run> the widget to reposition it; drag a bottom corner to resize the text.</Run>
                    </TextBlock>
                    <TextBlock Foreground="#FFA6ADC8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="#FF89B4FA">Right-click</Run>
                        <Run> for Settings, About, and Exit.</Run>
                    </TextBlock>
                </StackPanel>

                <Rectangle Height="1" Fill="#FF313244" Margin="0,12,0,0"/>

                <!-- Copyright banner -->
                <TextBlock Margin="0,12,0,0" Foreground="#FF6C7086" FontSize="11" TextWrapping="Wrap">
                    Copyright © 2026 LanDen Labs — Dennis Lang. Licensed under Apache 2.0.
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="4" Content="Close" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
